# generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# required for non-vercel deployments, vercel uses OIDC automatically
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=****

# optional: use OpenRouter directly instead of AI Gateway
# https://openrouter.ai
OPENROUTER_API_KEY=****
# optional override; defaults to https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=****

# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# https://vercel.com/docs/postgres
POSTGRES_URL=****
# If you're using Supabase Postgres directly, you can provide one of these instead of POSTGRES_URL
SUPABASE_DB_URL=****
SUPABASE_DATABASE_URL=****
# If you're using the Supabase transaction pooler with Drizzle, this is the preferred format
DATABASE_URL=****

# Supabase project URL and anon/publishable key (for browser/server SDK usage)
NEXT_PUBLIC_SUPABASE_URL=****
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=****

# https://vercel.com/docs/redis
REDIS_URL=****
